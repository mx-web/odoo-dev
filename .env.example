# Copy to .env (./odev does this on first run) and adjust.
# Every setting of the stack lives in this one file.

# ---------------------------------------------------------------------------
# Project / version
# ---------------------------------------------------------------------------
# The project name separates containers, volumes and networks. To run several
# Odoo versions side by side, copy the folder and change these lines plus the
# ports below.
COMPOSE_PROJECT_NAME=odoo19

# Any tag from https://hub.docker.com/_/odoo: 19.0, 18.0, 17.0, or pinned to a
# dated build such as 19.0-20260908 to match a production instance exactly.
ODOO_VERSION=19.0
POSTGRES_VERSION=17-alpine

# ---------------------------------------------------------------------------
# Ports (host side)
# ---------------------------------------------------------------------------
ODOO_PORT=8069
ODOO_GEVENT_PORT=8072
DB_HOST_PORT=5435
MAILPIT_UI_PORT=8026
MAILPIT_SMTP_PORT=1026
ADMINER_PORT=8081

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_USER=odoo
DB_PASSWORD=odoo
DB_MAXCONN=64
DB_FILTER=.*
LIST_DB=True

# Default database for all odev commands that take an optional [db]
ODOO_DB=odoo

# Master password of the database manager. Local use only — on anything
# reachable from the outside this must be a real secret and LIST_DB=False.
ADMIN_PASSWD=admin

# ---------------------------------------------------------------------------
# Addons
# ---------------------------------------------------------------------------
# Path to your own addons repository, relative to this folder, e.g.
# ../my-odoo-addons. Mounted at /mnt/addons/custom. Must be a directory that
# contains addon directories (not an addon itself).
CUSTOM_ADDONS=./addons

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# WORKERS=0 is required for --dev=reload and for debuggers.
WORKERS=0
MAX_CRON_THREADS=2
LIMIT_TIME_CPU=600
LIMIT_TIME_REAL=1200
LIMIT_MEMORY_SOFT=2147483648
LIMIT_MEMORY_HARD=2684354560
PROXY_MODE=False

LOG_LEVEL=info
LOG_HANDLER=:INFO

# Extra arguments passed to odoo. Switch with ./odev mode fast|live.
#   fast: --dev=reload            Python reload, templates/assets cached
#   live: --dev=reload,qweb,xml   templates/views/assets re-read on every request
#         (no upgrade needed, but several seconds per page)
ODOO_EXTRA_ARGS=--dev=reload

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# Points at the mailpit container (profile "mail"). Without that profile, mail
# goes nowhere — exactly what you want in a dev copy.
SMTP_SERVER=mail
SMTP_PORT=1025
EMAIL_FROM=odoo@localhost

# ---------------------------------------------------------------------------
# Production instance (for "./odev pull-prod")
# ---------------------------------------------------------------------------
# Any Odoo instance whose database manager (/web/database/manager) is
# reachable. Leave empty if you download dumps manually — then use
# "./odev restore <file.zip>".
PROD_URL=
PROD_DB=
PROD_MASTER_PW=
